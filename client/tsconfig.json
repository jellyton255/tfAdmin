{
    "compilerOptions": {
        "target": "es2022",
        "lib": ["es2022", "dom"],
        "module": "esnext",
        "moduleResolution": "bundler",
        "strict": true,
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "isolatedModules": true,
        "rootDir": "../",
        "outDir": "./dist"
    },
    "include": [
        "src/**/*",
        "../shared/apiV1Types.ts"
    ]
}
